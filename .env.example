# Copy to .env and fill every value. Generate signing secrets with:
#   openssl rand -hex 32
# Generate database and object-storage passwords with:
#   openssl rand -hex 24
# Use hex so passwords do not need URL encoding inside DATABASE_URL.

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

DATABASE_URL=
REDIS_URL=

S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_TTL_DAYS=
COOKIE_SECURE=

WEB_ORIGIN=
PORT=
INSTANCE_ID=

# Shared password for the local development accounts created by the seed script.
SEED_USER_PASSWORD=
